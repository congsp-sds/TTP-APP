{
  "App": {
    "Name": "Smart Factory Management System",
    "Version": "1.0.0",
    "Environment": "Production"
  },

  "ConnectionStrings": {
    "Default": "Server=localhost;Database=SmartFactory;Trusted_Connection=True;"
  },

  "Jwt": {
    "Issuer": "SmartFactory",
    "Audience": "SmartFactoryUsers",
    "SecretKey": "THIS_IS_DEMO_SECRET_CHANGE_ME",
    "ExpireMinutes": 60
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}

